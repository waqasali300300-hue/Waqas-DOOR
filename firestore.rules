rules_version = '2';
// Paste this in Firebase console → Firestore Database → Rules, then Publish.
// Replace the email with the one used to log in from the app (Cloud Setup).
// Add more emails to the list for other phones/staff with their own login.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['aap@gmail.com'];
    }
  }
}
